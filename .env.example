# Database (Neon Postgres)
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

# Payload CMS
PAYLOAD_SECRET=your-secret-key-here-change-me

# Vercel Blob Storage
BLOB_READ_WRITE_TOKEN=vercel_blob_xxx

# Contact form — Email (Resend). Free tier: 3k/mo. No domain needed (sends to self).
RESEND_API_KEY=re_xxx
CONTACT_EMAIL=you@example.com

# Contact form — Telegram push (free). Create a bot via @BotFather for the token,
# then get your chat id from https://api.telegram.org/bot<TOKEN>/getUpdates after messaging the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Contact form — WhatsApp via CallMeBot (free). Follow https://www.callmebot.com/blog/free-api-whatsapp-messages/
# Phone is your number with country code and NO leading + (e.g. 2348012345678).
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=

# GitHub Activity (for contribution sparkline)
GITHUB_TOKEN=ghp_xxx
GITHUB_USERNAME=btom7447
